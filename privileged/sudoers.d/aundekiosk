# AundeKiosk privileged helper whitelist.
# The dashboard runs as the unprivileged `aundekiosk` system user and may
# only invoke these exact, argument-free scripts without a password.
# No wildcard arguments are ever granted here — each future privileged
# action gets its own fixed line, added and reviewed individually.
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/restart-kiosk-services.sh
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/reboot-device.sh
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-ssh.sh enable
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-ssh.sh disable
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-ssh-password-auth.sh enable
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-ssh-password-auth.sh disable
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/change-os-password.sh
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/apply-network-config.sh
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/confirm-network-config.sh
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/configure-snmp.sh
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-vnc.sh enable
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-vnc.sh disable
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/change-hostname.sh
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-dashboard start
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-dashboard stop
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-monitor start
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-monitor stop
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-runner start
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-runner stop
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-switcher start
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/toggle-service.sh aundekiosk-switcher stop
aundekiosk ALL=(root) NOPASSWD: /opt/aundekiosk/privileged/apt-upgrade.sh start

[Unit]
Description=Run AundeKiosk dashboard
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/deno run --allow-net=0.0.0.0:8080 --allow-read=/opt/aundekiosk --allow-write=/opt/aundekiosk --allow-env=PORT,AUNDEKIOSK_CONFIG_FILE /opt/aundekiosk/dashboard/server.ts
WorkingDirectory=/opt/aundekiosk
Environment=PORT=8080
User=aundekiosk
Restart=on-failure

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS aundekiosk-dist dizinine koyulacak web.config.
  .gz ve .sh dosyalarinin dogru MIME type ile sunulmasini saglar.
  setup-iis-dir.ps1 tarafindan otomatik olarak kopyalanir.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".gz" mimeType="application/gzip" />
      <remove fileExtension=".sh" />
      <mimeMap fileExtension=".sh" mimeType="text/plain" />
    </staticContent>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
